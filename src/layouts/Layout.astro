---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';
import { buildBusiness } from '../data/structuredData.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object[];
}

const { title, description, image = 'images/Conseil_en_image_les_Clayes_sous_Bois_banner.png', jsonLd = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
// <base href> is set, so canonical and social URLs must be absolute.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// Business data on every page; pages add their own (FAQ, Service) via the jsonLd prop.
const structuredData = [buildBusiness(), ...jsonLd];
const imageUrl = new URL(image, new URL(baseUrl, Astro.site)).href;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <base href={baseUrl} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="La Juste Nuance">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={imageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>

  {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

  <!-- Calendly Widget CSS -->
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
  
  <link rel="icon" type="image/png" href="images/Conseil_en_image_les_Clayes_sous_Bois_logo.png">
</head>
<body>
  <Header />
  
  <slot />

  <Footer />

  <!-- Bundled Client script -->
  <script>
    import '../scripts/main.js';
  </script>

  <!-- Calendly link integration script support -->
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
</body>
</html>
