---
// GoogleReviews.astro
// Fetch reviews at build time if API key is provided, otherwise fallback to static reviews.

const API_KEY = import.meta.env.GOOGLE_PLACES_API_KEY || '';
const PLACE_ID = 'ChIJL4RS02byQk8R3RfO5vVq48I'; // The Place ID we found for "La Juste Nuance Les Clayes-sous-Bois"

let reviews = [];

if (API_KEY && PLACE_ID) {
  try {
    const res = await fetch(`https://maps.googleapis.com/maps/api/place/details/json?place_id=${PLACE_ID}&fields=reviews&language=fr&key=${API_KEY}`);
    const data = await res.json();
    if (data.result && data.result.reviews) {
      reviews = data.result.reviews.sort((a, b) => b.time - a.time).slice(0, 2);
    }
  } catch (error) {
    console.error("Error fetching Google Reviews at build time:", error);
  }
}
---

<div id="reviews-grid" class="reviews-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; max-width: 960px; margin: 3rem auto 0;">
  {reviews.length > 0 ? (
    <>{reviews.map((review) => {
      const rating = review.rating || 5;
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      return (
        <div class="review-card" style="background: var(--color-white); padding: 2.2rem; border-radius: var(--border-radius-md); box-shadow: var(--color-shadow); text-align: left; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem;">
              <div style="color: #fbbc04; font-size: 1.25rem; letter-spacing: 2px;">{stars}</div>
              <span style="font-size: 0.78rem; background: #e8f0fe; color: #1a73e8; padding: 0.25rem 0.65rem; border-radius: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v3.8h5.4c-.2 1.2-.9 2.3-2 3.1v2.5h3.2c1.9-1.7 3-4.3 3-7.5 0-.7-.1-1.3-.2-1.9z"/><path d="M12 21c2.7 0 5-1 6.7-2.6l-3.2-2.5c-.9.6-2 1-3.5 1-2.7 0-4.9-1.8-5.7-4.3H3.1v2.6C4.8 18.6 8.1 21 12 21z"/><path d="M6.3 12.6c-.2-.6-.3-1.3-.3-2.1s.1-1.5.3-2.1V5.8H3.1C2.4 7.2 2 8.8 2 10.5s.4 3.3 1.1 4.7l3.2-2.6z"/><path d="M12 4.1c1.5 0 2.8.5 3.8 1.5l2.8-2.8C16.9 1.2 14.6 0 12 0 8.1 0 4.8 2.4 3.1 5.8l3.2 2.6c.8-2.5 3-4.3 5.7-4.3z"/></svg>
                Avis Google
              </span>
            </div>
            <p style="font-size: 1.02rem; line-height: 1.7; color: var(--color-muted); font-style: italic; margin-bottom: 1.5rem;">
              « {review.text} »
            </p>
          </div>
          <div style="border-top: 1px solid rgba(0,0,0,0.06); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 600; color: var(--color-dark); font-size: 0.95rem;">{review.author_name}</span>
            <a href={review.author_url || "https://share.google/VFzPfggmkcKAPCM3x"} target="_blank" rel="noopener noreferrer" style="font-size: 0.82rem; color: var(--color-sage-dark); text-decoration: underline;">Voir l'avis complet</a>
          </div>
        </div>
      );
    })}</>
  ) : (
    <>{/* Fallback statique si pas de clé API ou d'avis */}
    <div class="review-card" style="background: var(--color-white); padding: 2.2rem; border-radius: var(--border-radius-md); box-shadow: var(--color-shadow); text-align: left; display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem;">
          <div style="color: #fbbc04; font-size: 1.25rem; letter-spacing: 2px;">★★★★★</div>
          <span style="font-size: 0.78rem; background: #e8f0fe; color: #1a73e8; padding: 0.25rem 0.65rem; border-radius: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v3.8h5.4c-.2 1.2-.9 2.3-2 3.1v2.5h3.2c1.9-1.7 3-4.3 3-7.5 0-.7-.1-1.3-.2-1.9z"/><path d="M12 21c2.7 0 5-1 6.7-2.6l-3.2-2.5c-.9.6-2 1-3.5 1-2.7 0-4.9-1.8-5.7-4.3H3.1v2.6C4.8 18.6 8.1 21 12 21z"/><path d="M6.3 12.6c-.2-.6-.3-1.3-.3-2.1s.1-1.5.3-2.1V5.8H3.1C2.4 7.2 2 8.8 2 10.5s.4 3.3 1.1 4.7l3.2-2.6z"/><path d="M12 4.1c1.5 0 2.8.5 3.8 1.5l2.8-2.8C16.9 1.2 14.6 0 12 0 8.1 0 4.8 2.4 3.1 5.8l3.2 2.6c.8-2.5 3-4.3 5.7-4.3z"/></svg>
            Avis Google
          </span>
        </div>
        <p style="font-size: 1.02rem; line-height: 1.7; color: var(--color-muted); font-style: italic; margin-bottom: 1.5rem;">
          « Prestation très intéressante, j'ai appris beaucoup de choses et d'astuces. Florence est patiente, positive et à l'écoute. Après notre rencontre, j'ai compris que le but n'était pas de racheter une garde robe complète mais plutôt d'adapter la mienne à mon physique et ma personnalité. Merci pour ce RDV ! »
        </p>
      </div>
      <div style="border-top: 1px solid rgba(0,0,0,0.06); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 600; color: var(--color-dark); font-size: 0.95rem;">Deesse Lylith</span>
        <a href="https://maps.app.goo.gl/bjxBjNBTqJhmrFMT9" target="_blank" rel="noopener noreferrer" style="font-size: 0.82rem; color: var(--color-sage-dark); text-decoration: underline;">Voir l'avis complet</a>
      </div>
    </div>

    <div class="review-card" style="background: var(--color-white); padding: 2.2rem; border-radius: var(--border-radius-md); box-shadow: var(--color-shadow); text-align: left; display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem;">
          <div style="color: #fbbc04; font-size: 1.25rem; letter-spacing: 2px;">★★★★★</div>
          <span style="font-size: 0.78rem; background: #e8f0fe; color: #1a73e8; padding: 0.25rem 0.65rem; border-radius: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v3.8h5.4c-.2 1.2-.9 2.3-2 3.1v2.5h3.2c1.9-1.7 3-4.3 3-7.5 0-.7-.1-1.3-.2-1.9z"/><path d="M12 21c2.7 0 5-1 6.7-2.6l-3.2-2.5c-.9.6-2 1-3.5 1-2.7 0-4.9-1.8-5.7-4.3H3.1v2.6C4.8 18.6 8.1 21 12 21z"/><path d="M6.3 12.6c-.2-.6-.3-1.3-.3-2.1s.1-1.5.3-2.1V5.8H3.1C2.4 7.2 2 8.8 2 10.5s.4 3.3 1.1 4.7l3.2-2.6z"/><path d="M12 4.1c1.5 0 2.8.5 3.8 1.5l2.8-2.8C16.9 1.2 14.6 0 12 0 8.1 0 4.8 2.4 3.1 5.8l3.2 2.6c.8-2.5 3-4.3 5.7-4.3z"/></svg>
            Avis Google
          </span>
        </div>
        <p style="font-size: 1.02rem; line-height: 1.7; color: var(--color-muted); font-style: italic; margin-bottom: 1.5rem;">
          « Une expérience précieuse que je recommande à toutes celles qui souhaitent trouver un style qui leur ressemble vraiment ! (...) Avec La Juste Nuance, Florence propose bien plus qu'une étude de colorimétrie. Son accompagnement est une véritable parenthèse qui permet de mieux se connaître et d'aligner son image avec sa personnalité. »
        </p>
      </div>
      <div style="border-top: 1px solid rgba(0,0,0,0.06); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 600; color: var(--color-dark); font-size: 0.95rem;">Stel R</span>
        <a href="https://maps.app.goo.gl/if19BkrAwQPfk9Xf8" target="_blank" rel="noopener noreferrer" style="font-size: 0.82rem; color: var(--color-sage-dark); text-decoration: underline;">Voir l'avis complet</a>
      </div>
    </div>
    </>
  )}
</div>
